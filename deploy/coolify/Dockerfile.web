# syntax=docker/dockerfile:1.7
###############################################################################
# BANCO web surfaces — Vite SPA builds + Nginx
# Coolify / Hostinger VPS production image.
#
# Builds three Vite SPAs and serves them from a single Nginx:
#   admin-os  → /admin/
#   dealer-os → /market/
#   landing   → /  (root)
#
# Optionally proxies /api/* to the api service (banco_api upstream).
#
# VITE_* vars are baked at build time (publishable keys + public URLs only).
#
# Build context = REPOSITORY ROOT:
#   docker build -f deploy/coolify/Dockerfile.web \
#     --build-arg VITE_CLERK_PUBLISHABLE_KEY=pk_live_... \
#     --build-arg VITE_API_BASE_URL=https://api.yourdomain.com \
#     -t banco-web-surfaces .
###############################################################################

FROM node:24-bookworm-slim AS builder
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

# Build-time public config — safe to bake (publishable keys + public URLs).
ARG VITE_CLERK_PUBLISHABLE_KEY=
ARG VITE_API_BASE_URL=
ARG VITE_MARKET_URL=
ARG VITE_ADMIN_URL=
ARG VITE_APP_ANDROID_URL=
ARG VITE_APP_IOS_URL=

ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY \
    VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_MARKET_URL=$VITE_MARKET_URL \
    VITE_ADMIN_URL=$VITE_ADMIN_URL \
    VITE_APP_ANDROID_URL=$VITE_APP_ANDROID_URL \
    VITE_APP_IOS_URL=$VITE_APP_IOS_URL

# Copy manifests first for pnpm install layer cache.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc tsconfig.base.json tsconfig.json ./
COPY scripts/preinstall-enforce-pnpm.mjs ./scripts/preinstall-enforce-pnpm.mjs
COPY lib ./lib
COPY artifacts/admin-os/package.json   ./artifacts/admin-os/package.json
COPY artifacts/dealer-os/package.json  ./artifacts/dealer-os/package.json
COPY artifacts/landing/package.json    ./artifacts/landing/package.json
# Remaining workspace members needed for lockfile validation (pnpm-workspace.yaml
# lists artifacts/*, lib/*, lib/integrations/*, scripts — all need a package.json).
COPY scripts/package.json                  ./scripts/package.json
COPY artifacts/api-server/package.json     ./artifacts/api-server/package.json
COPY artifacts/banco-web/package.json      ./artifacts/banco-web/package.json
COPY artifacts/banco-website/package.json  ./artifacts/banco-website/package.json
COPY artifacts/banco-mobile/package.json   ./artifacts/banco-mobile/package.json
COPY artifacts/mockup-sandbox/package.json ./artifacts/mockup-sandbox/package.json

RUN --mount=type=cache,id=pnpm-web,target=/pnpm/store \
    pnpm install --frozen-lockfile \
      --filter "@workspace/admin-os..." \
      --filter "@workspace/dealer-os..." \
      --filter "@workspace/landing..."

# Copy only the SPA sources (not the whole repo to keep layer small).
COPY artifacts/admin-os   ./artifacts/admin-os
COPY artifacts/dealer-os  ./artifacts/dealer-os
COPY artifacts/landing    ./artifacts/landing

RUN pnpm --filter @workspace/admin-os \
         --filter @workspace/dealer-os \
         --filter @workspace/landing \
         run build

# ---- runner: Nginx serving the three SPAs + optional API proxy ---------------
FROM nginx:1.27-alpine AS runner
RUN rm -rf /usr/share/nginx/html/*

# Each SPA under its own path prefix.
COPY --from=builder /app/artifacts/landing/dist    /usr/share/nginx/html/
COPY --from=builder /app/artifacts/dealer-os/dist  /usr/share/nginx/html/market/
COPY --from=builder /app/artifacts/admin-os/dist   /usr/share/nginx/html/admin/

COPY deploy/coolify/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/nginx-health || exit 1

# syntax=docker/dockerfile:1.7
###############################################################################
# BANCO marketing website — Next.js standalone (artifacts/banco-website)
# Coolify / Hostinger VPS production image.
#
# Same build pattern as Dockerfile.banco-web but targets artifacts/banco-website.
# NEXT_PUBLIC_* vars are baked at build time.
# Runtime secrets are injected via environment vars.
#
# Build context = REPOSITORY ROOT:
#   docker build -f deploy/coolify/Dockerfile.banco-website \
#     --build-arg NEXT_PUBLIC_API_URL=https://api.yourdomain.com \
#     --build-arg NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com \
#     --build-arg NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_... \
#     -t banco-website .
###############################################################################

FROM node:24-bookworm-slim AS builder
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

# Build-time public config (publishable keys + public URLs only).
ARG NEXT_PUBLIC_API_URL=http://localhost:8080
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ARG NEXT_PUBLIC_SITE_URL_EN=
ARG NEXT_PUBLIC_MARKET_URL=
ARG NEXT_PUBLIC_ADMIN_URL=
ARG NEXT_PUBLIC_APP_ANDROID_URL=
ARG NEXT_PUBLIC_APP_IOS_URL=
ARG NEXT_PUBLIC_SEARCH_ENABLED=true
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
ARG NEXT_PUBLIC_CLERK_PROXY_URL=
ARG NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

ENV NEXT_STANDALONE=true \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_SITE_URL_EN=$NEXT_PUBLIC_SITE_URL_EN \
    NEXT_PUBLIC_MARKET_URL=$NEXT_PUBLIC_MARKET_URL \
    NEXT_PUBLIC_ADMIN_URL=$NEXT_PUBLIC_ADMIN_URL \
    NEXT_PUBLIC_APP_ANDROID_URL=$NEXT_PUBLIC_APP_ANDROID_URL \
    NEXT_PUBLIC_APP_IOS_URL=$NEXT_PUBLIC_APP_IOS_URL \
    NEXT_PUBLIC_SEARCH_ENABLED=$NEXT_PUBLIC_SEARCH_ENABLED \
    NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY \
    NEXT_PUBLIC_CLERK_PROXY_URL=$NEXT_PUBLIC_CLERK_PROXY_URL \
    NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=$NEXT_PUBLIC_GOOGLE_MAPS_API_KEY

# Copy manifests first for layer-cache efficiency.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc tsconfig.base.json tsconfig.json ./
COPY scripts/preinstall-enforce-pnpm.mjs ./scripts/preinstall-enforce-pnpm.mjs
COPY lib ./lib
COPY artifacts/banco-website/package.json ./artifacts/banco-website/package.json

RUN --mount=type=cache,id=pnpm-banco-website,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "@workspace/banco-website..."

COPY artifacts/banco-website ./artifacts/banco-website

RUN pnpm --filter @workspace/banco-website run build

# ---- runner: minimal Next.js standalone image --------------------------------
FROM node:24-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/artifacts/banco-website/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/artifacts/banco-website/.next/static \
     ./artifacts/banco-website/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/artifacts/banco-website/public \
     ./artifacts/banco-website/public

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"

CMD ["node", "artifacts/banco-website/server.js"]

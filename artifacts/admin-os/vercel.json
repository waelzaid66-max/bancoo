{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @workspace/admin-os run build",
  "outputDirectory": "dist/public",
  "ignoreCommand": "node ../../scripts/vercel-ignore-unless.mjs artifacts/admin-os"
}
